// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
  // output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}


model User {
  id            String         @id @default(uuid())
  name          String?
  email         String          @unique
  password      String?         // null si inicia con Google u otra red
  googleId      String?         @unique
  balanceCoins  Int             @default(0) // reservado para fases futuras (cripto/coins)

  raffles       Raffle[]        @relation("UserRaffles")
  tickets       Ticket[]
  transactions  Transaction[]

  // Relación con rifas ganadas
  rafflesWon    Raffle[]        @relation("RaffleWinner")

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Raffle {
  id                String         @id @default(uuid())
  title             String
  description       String?
  productName       String
  productImage      String?
  ticketPriceCoins  Int            // precio por participación, en ARS
  totalTickets      Int
  ticketsSold       Int             @default(0)
  status            RaffleStatus    @default(OPEN)

  creatorId         String
  creator           User            @relation("UserRaffles", fields: [creatorId], references: [id], onDelete: Cascade)

  tickets           Ticket[]

  winnerId          String?
  winner            User?           @relation("RaffleWinner", fields: [winnerId], references: [id])

  drawnAt           DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Ticket {
  id           String       @id @default(uuid())
  raffleId     String
  userId       String
  number       Int          // número de participación asignado dentro de la raffle
  source       TicketSource @default(PAID)
  raffle       Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasedAt  DateTime     @default(now())

  @@unique([raffleId, number])
}

model Transaction {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  amount       Int
  description  String?
  createdAt    DateTime         @default(now())
}

enum TransactionType {
  DEPOSIT
  SPEND
  REFUND
  WIN
}

enum TransactionStatus {
  PENDING
  APPROVED
  CANCELLED
  REJECTED
  EXPIRED
}

enum RaffleStatus {
  OPEN       // recibiendo participaciones
  SOLD_OUT   // todos los tickets vendidos, pendiente de sorteo
  DRAWN      // sorteo realizado, ganador asignado
}

enum TicketSource {
  PAID  // participación pagada (MercadoPago / cripto a futuro)
  AD    // participación gratuita por ver publicidad
}
