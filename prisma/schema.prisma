// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String?
  email         String          @unique
  password      String?
  googleId      String?         @unique
  balanceCoins  Int             @default(0)
  isAdmin       Boolean         @default(false)  // NUEVO

  raffles       Raffle[]        @relation("UserRaffles")
  tickets       Ticket[]
  transactions  Transaction[]
  rafflesWon    Raffle[]        @relation("RaffleWinner")

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Raffle {
  id                String         @id @default(uuid())
  title             String
  description       String?
  productName       String
  productImages     RaffleImage[]
  ticketPriceCoins  Int
  totalTickets      Int
  ticketsSold       Int             @default(0)
  status            RaffleStatus    @default(OPEN)
  featured          Boolean         @default(false)

  creatorId         String
  creator           User            @relation("UserRaffles", fields: [creatorId], references: [id], onDelete: Cascade)

  tickets           Ticket[]

  winnerId          String?
  winner            User?           @relation("RaffleWinner", fields: [winnerId], references: [id])

  drawnAt           DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model RaffleImage {
  id        String   @id @default(uuid())
  url       String
  order     Int      @default(0)
  raffleId  String
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Ticket {
  id           String       @id @default(uuid())
  raffleId     String
  userId       String
  number       Int
  source       TicketSource @default(PAID)
  raffle       Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchasedAt  DateTime     @default(now())

  @@unique([raffleId, number])
}

model Transaction {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         Int
  description    String?
  raffleId       String?
  ticketQuantity Int?
  createdAt      DateTime         @default(now())
}

enum TransactionType {
  DEPOSIT
  SPEND
  REFUND
  WIN
}

enum TransactionStatus {
  PENDING
  APPROVED
  CANCELLED
  REJECTED
  EXPIRED
}

enum RaffleStatus {
  OPEN
  SOLD_OUT
  DRAWN
}

enum TicketSource {
  PAID
  AD
}
